{
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "watch": "tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "build": "npx tailwindcss -i ./src/input.css -o ./public/output.css --minify"
  },
  "lavamoat": {
    "allowScripts": {
      "@tailwindcss/cli>@parcel/watcher#2.5.1": true
    }
  }
}
